# Copia este archivo como ".env" (sin ".example") y rellena tus valores.
# El archivo .env NO se sube a git (está en .gitignore). Nunca pongas estas claves en el código ni en el HTML.

# Cuenta de administrador (la única con acceso al panel de moderación).
# Usuario: 3 a 20 caracteres (letras, números, _ y .). Contraseña: mínimo 10 caracteres.
ADMIN_USER=
ADMIN_PASS=

# Opcional: carpeta donde se guardan cuentas, reportes y reseñas.
# En Render apunta al disco persistente que montes (por ejemplo /var/data). En tu PC puedes dejarlo vacío.
# DATA_DIR=

# Base de datos PostgreSQL (Neon). Pega aquí la cadena de conexión que te da Neon (empieza con postgresql://).
# Si la dejas vacía, la app guarda todo en archivos JSON dentro de data/ (solo para probar en tu computadora).
DATABASE_URL=

# Nombre PÚBLICO de tu cuenta de administrador/vendedor oficial (lo ven todos). Tu usuario de login (ADMIN_USER) nunca se muestra.
OFFICIAL_NAME=U2U Oficial

# --- Protección de datos (bloque 3) ---
# Máximo de publicaciones ACTIVAS por usuario (disponibles, pausadas y reservadas; no cuentan vendidas ni eliminadas).
# La cuenta oficial (admin) está exenta. Si falta o no es un número válido, se usa 10.
PUB_LIMIT_USER=10

# Tope de la app para la base de datos, en MB (se compara con el espacio real usado en PostgreSQL).
# Al llegar al tope se rechazan publicaciones NUEVAS (STORAGE_FULL); nunca se borra nada. Aviso en el log desde el 90 %.
# Verifica en el panel de Neon el límite real de tu plan antes de cambiarlo. Si falta, se usa 400.
STORAGE_LIMIT_MB=400

# --- Correo UPC: envío y límites (bloque 6) ---
# Proveedor de correo: brevo (se envía por internet con fetch; Render bloquea SMTP). Sin proveedor completo
# (EMAIL_PROVIDER, BREVO_API_KEY y EMAIL_FROM) o con EMAIL_DEV_MODE=true, el código de verificación sale en la consola del servidor.
EMAIL_PROVIDER=
BREVO_API_KEY=
# Remitente verificado en Brevo. Ejemplo: U2U <no-reply@tudominio.com>
EMAIL_FROM=
EMAIL_DEV_MODE=false
# Tope global de correos por día (hora de Lima). Al llegar: «Hoy se alcanzó el límite, vuelve mañana». Si falta, se usa 250.
# (Fijos en el código: 5 códigos por hora por correo y 200 por hora por IP.)
EMAIL_DAILY_LIMIT=250
# Plan B si los egresados no tienen correo UPC activo: con true no se envía código y cada cuenta nueva queda pendiente
# hasta que la cuenta oficial la apruebe (GET /api/admin/pending, POST /api/admin/approve | reject).
REGISTRO_MANUAL=false

# --- Pedidos (v8.7.0) ---
# Horas que un pedido pendiente espera antes de cancelarse solo y liberar la reserva (alquileres: desde el día de inicio). Si falta, 48.
ORDER_TTL_HOURS=48

# --- Comisión por venta (parte A; todo opcional, nace APAGADA) ---
# off = nada cambia · shadow = registra la comisión sin mostrar ni restringir (solo la ve el admin) · active = flujo completo. Si falta, off.
COMMISSION_MODE=off
# Porcentaje sobre el precio del producto (0.03 = 3 %). Si falta, 0.03.
COMMISSION_RATE=0.03
# all = el vendedor con comisión pendiente no puede enviar mensajes · new = no puede publicar, reservar ni abrir chats nuevos. Si falta, all.
COMMISSION_BLOCK_SCOPE=all
# Yape: SOLO en Render (Environment), nunca en el código ni en archivos del repositorio. Se entrega solo a vendedores con comisión pendiente.
YAPE_NUMBER=
YAPE_HOLDER=

# --- Destacar publicaciones (parte C; todo opcional, nace APAGADO) ---
# off = nadie puede solicitar · free = el dueño solicita y el admin activa SIN cobro (piloto) · paid = el dueño paga por Yape, reporta y el admin aprueba.
# paid necesita YAPE_NUMBER (arriba); sin él, destacados queda desactivado con un aviso en el log. Si falta FEATURE_MODE, off.
FEATURE_MODE=off
# Precio en soles (solo paid). Si falta o no es válido, 2.
FEATURE_PRICE=2
# Días que dura cada destacado (renovar suma días al vencimiento vigente). Si falta, 7 (máx. 90).
FEATURE_DAYS=7
# Máximo de publicaciones destacadas vigentes a la vez (code FEATURE_FULL al llegar al tope). Si falta, 6.
MAX_FEATURED=6
